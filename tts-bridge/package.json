{
  "name": "trpg-voice-bridge",
  "version": "0.5.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "version": "node packaging/version.mjs",
    "version:check": "node packaging/version.mjs --check",
    "start": "node main.mjs",
    "test": "node --test *.test.mjs src/*.test.mjs discord/*.test.mjs packaging/*.test.mjs",
    "test:browser": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package:build": "node packaging/build.mjs",
    "package:smoke": "node packaging/smoke.mjs",
    "package:speech": "node packaging/build-speech.mjs",
    "package:tts-smoke": "node packaging/tts-smoke.mjs",
    "chatter:build": "node chatter/build.mjs",
    "package:smoke:browser": "node packaging/smoke.mjs --browser"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "0.28.2",
    "postject": "1.0.0-alpha.6",
    "prettier": "^3.9.9"
  }
}
